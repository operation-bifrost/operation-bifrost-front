                              "children": [
                                {
                                  "type": "frame",
                                  "id": "lBjNt",
                                  "name": "Description",
                                  "stroke": {
                                    "align": "inside",
                                    "thickness": 1
                                  },
                                  "layout": "vertical",
                                  "gap": 5,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "dxC2H",
                                      "name": "Title",
                                      "fill": "#f9fafbff",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Orange",
                                      "fontFamily": "Inter",
                                      "fontSize": 20,
                                      "fontWeight": "700"
                                    },
                                    {
                                      "type": "text",
                                      "id": "DHkqd",
                                      "name": "Description",
                                      "fill": "#f3f4f6ff",
                                      "textGrowth": "fixed-width",
                                      "width": 718,
                                      "content": "Orange is a warm and energetic color that can evoke feelings of excitement and creativity. In a design system, it can draw attention to important elements or calls to action. It's associated with youthfulness, friendliness, and warmth, popular in the food, health, and beauty industries. When used in UI/UX design, orange can create playfulness and engagement as an accent color.",
                                      "fontFamily": "Inter",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "sd92e",
                                  "name": "Extra",
                                  "cornerRadius": 4,
                                  "stroke": {
                                    "align": "inside",
                                    "thickness": 1
                                  },
                                  "gap": 10,
                                  "padding": [
                                    8,
                                    14
                                  ],
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "WFf2a",
