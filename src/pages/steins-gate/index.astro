---
import SteinsGateLayout from "@/layouts/steins-gate.astro";
import { Navbar } from "@/components/steins-gate/navbar/navbar";
import { Hero } from "@/components/steins-gate/hero/hero";
import { Features } from "@/components/steins-gate/features/features";
import { Gallery } from "@/components/steins-gate/gallery/gallery";
import { Wall } from "@/components/steins-gate/wall/wall";
import { Download } from "@/components/steins-gate/download/download";
import { Faq } from "@/components/steins-gate/faq/faq";
import { Credits } from "@/components/steins-gate/credits/credits";
import { Donate } from "@/components/steins-gate/donate/donate";
import { Footer } from "@/components/steins-gate/footer/footer";

const title = "ม็อด STEINS;GATE ฉบับแปลไทยเต็มรูปแบบ | Operation Bifrost";
const description =
  "ม็อด STEINS;GATE ฉบับแปลไทยเต็มรูปแบบ ใช้กับ Visual Novel เวอร์ชัน Steam (ภาษาอังกฤษ) แปลครบทั้งเนื้อเรื่อง สารานุกรม เมลตัวละคร และซับเพลงประกอบ แจกฟรี ดาวน์โหลดและติดตั้งได้เลย";
const ogDescription =
  "ม็อด STEINS;GATE ฉบับแปลไทยเต็มรูปแบบ ใช้กับ Visual Novel เวอร์ชัน Steam (ภาษาอังกฤษ) แปลครบทั้งเนื้อเรื่อง สารานุกรม เมลตัวละคร และซับเพลงประกอบ แจกฟรี ดาวน์โหลดและติดตั้งได้เลย";
const twitterDescription =
  "ม็อด STEINS;GATE ฉบับแปลไทยเต็มรูปแบบ ใช้กับ Visual Novel เวอร์ชัน Steam (ภาษาอังกฤษ) แปลครบทั้งเนื้อเรื่อง สารานุกรม เมลตัวละคร และซับเพลงประกอบ แจกฟรี ดาวน์โหลดและติดตั้งได้เลย";
---

<SteinsGateLayout
  title={title}
  description={description}
  canonical="https://operationbifrost.com/steins-gate/"
  ogDescription={ogDescription}
  twitterTitle={title}
  twitterDescription={twitterDescription}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="ม็อดแปลไทย Steins;Gate, แพตช์ไทย Steins;Gate, STEINS;GATE ภาษาไทย, ดาวน์โหลดม็อด Steins;Gate, Steins;Gate Steam, fan translation, visual novel, Operation Bifrost, ปฏิบัติการไบฟรอสต์, Science Adventure, สไตนส์เกต"
    />
  </Fragment>

  <Navbar client:load />

  {
    /* Single page-level stacking context: section decorations sit at -z-10
      behind all content and bleed across section seams. overflow-x-clip
      stops rotated/oversized decor from spawning a horizontal scrollbar
      (replaces the per-section overflow-hidden that used to clip gears). */
  }
  <div class="relative isolate overflow-x-clip">
    <Hero />
    <Features client:visible={{ rootMargin: "200px" }} />
    <Gallery client:visible={{ rootMargin: "200px" }} />
    <Download client:visible={{ rootMargin: "200px" }} />
    <Faq client:visible={{ rootMargin: "200px" }} />
    <Credits client:visible />
    <Donate client:visible />
    <Wall client:visible />
  </div>

  <Footer client:visible={{ rootMargin: "200px" }} />
</SteinsGateLayout>
