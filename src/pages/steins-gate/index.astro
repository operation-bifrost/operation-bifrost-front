---
import SteinsGateLayout from "@/layouts/steins-gate.astro";
import { Navbar } from "@/components/steins-gate/navbar/navbar";
import { Hero } from "@/components/steins-gate/hero/hero";
import { Features } from "@/components/steins-gate/features/features";
import { Gallery } from "@/components/steins-gate/gallery/gallery";
import { Download } from "@/components/steins-gate/download/download";
import { Faq } from "@/components/steins-gate/faq/faq";

const title = "Operation Bifrost | ปฏิบัติการไบฟรอส - โปรเจกต์แปล Steins;Gate ภาษาไทย";
const description =
  "โครงการแปลเกมวิชวลโนเวล Steins;Gate เป็นภาษาไทย ทลายกำแพงภาษาสำหรับแฟนๆ ชาวไทยของซีรีส์ Science Adventure ติดตามความคืบหน้าการแปลแบบเรียลไทม์ได้ที่นี่";
const ogDescription =
  "โครงการแปลเกมวิชวลโนเวล Steins;Gate เป็นภาษาไทย ติดตามความคืบหน้าการแปลแบบเรียลไทม์และเข้าร่วมชุมชนของเราได้ที่นี่";
const twitterDescription =
  "โครงการแปลเกมวิชวลโนเวล Steins;Gate เป็นภาษาไทย ติดตามความคืบหน้าการแปลแบบเรียลไทม์ได้ที่นี่";
---

<SteinsGateLayout
  title={title}
  description={description}
  canonical="https://operationbifrost.com/steins-gate/"
  ogDescription={ogDescription}
  twitterTitle="ปฏิบัติการไบฟรอส | Operation Bifrost"
  twitterDescription={twitterDescription}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Steins;Gate, การแปลภาษาไทย, fan translation, visual novel, Operation Bifrost, ปฏิบัติการไบฟรอส, Science Adventure, localization, สไตนส์เกต"
    />
  </Fragment>

  <Navbar client:load />

  {
    /* Single page-level stacking context: section decorations sit at -z-10
      behind all content and bleed across section seams. overflow-x-clip
      stops rotated/oversized decor from spawning a horizontal scrollbar
      (replaces the per-section overflow-hidden that used to clip gears). */
  }
  <div class="relative isolate overflow-x-clip">
    <Hero />
    <Features client:load />
    <Gallery client:load />
    <Download client:load />
    <Faq client:load />
  </div>
</SteinsGateLayout>
