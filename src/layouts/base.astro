---
import "@fontsource/krub/400.css";
import "@fontsource/krub/700.css";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  lang?: string;
  locale?: string;
  siteName?: string;
  htmlClass?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = "/og-image.png",
  ogTitle = title,
  ogImageAlt = ogTitle,
  ogDescription = description,
  twitterTitle = title,
  twitterDescription = description,
  lang = "th",
  locale = "th_TH",
  siteName = "Operation Bifrost",
  htmlClass = "",
  author = "Operation Bifrost Team",
} = Astro.props;

// The dev/staging Worker (operationbifrost-dev → develop.operationbifrost.com) is
// built with CLOUDFLARE_ENV=dev (see wrangler.jsonc / yarn wrangler:deploy:dev),
// surfaced here as import.meta.env.PUBLIC_DEPLOY_ENV (baked in astro.config.mjs).
// Pages are prerendered, so anything env-specific is decided at build time, not
// per request. Used below for the noindex guard and the og:image origin.
const isProductionBuild = import.meta.env.PUBLIC_DEPLOY_ENV === "production";

// Local dev (incl. cloudflared/ngrok tunnels): `astro dev` renders on demand, so
// Astro.url is the live request — advertise the tunnel's own card so social
// previews of a *.trycloudflare.com link aren't pinned to the prod image. The dev
// server speaks http to the tunnel, so force https for any non-localhost host
// (scrapers want https); keep http for plain localhost.
const isLocalHost = ["localhost", "127.0.0.1"].includes(Astro.url.hostname);
const devRequestOrigin = `${isLocalHost ? Astro.url.protocol : "https:"}//${Astro.url.host}`;

// og:image / twitter:image must be absolute for FB / X / LINE scrapers. Pick the
// origin per context: local dev → the live request origin (above); prod build →
// Astro.site; non-prod build (develop.*) → the dev origin, else previews point at
// operationbifrost.com, which serves the LEGACY prod card until develop is merged.
// import.meta.env.DEV is statically false in any build, so the request-origin
// branch is dead-code-eliminated from the prerendered deploys — it only ever runs
// in the live dev server. (canonical / og:url intentionally stay on production.)
const imageOrigin = import.meta.env.DEV
  ? devRequestOrigin
  : isProductionBuild
    ? (Astro.site ?? canonical)
    : "https://develop.operationbifrost.com";
const ogImageUrl = new URL(ogImage, imageOrigin).href;
---

<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {/* Non-production (dev/staging) builds only — keeps develop.* out of the index. */}
    {!isProductionBuild && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter/X cards use `name` (not `property`) per the card spec. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Site-wide analytics: tracks all routes that use this layout (or any layout that wraps it). -->
    <script
      is:inline
      defer
      data-domain="operationbifrost.com"
      src="https://plausible.io/js/script.js"></script>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
