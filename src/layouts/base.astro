---
import "@fontsource/krub/400.css";
import "@fontsource/krub/700.css";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  lang?: string;
  htmlClass?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = "/og-image.png",
  ogTitle = title,
  ogDescription = description,
  twitterTitle = title,
  twitterDescription = description,
  lang = "th",
  htmlClass = "",
  author = "Operation Bifrost Team",
} = Astro.props;

// og:image / twitter:image must be absolute for FB / X / LINE scrapers. Resolve
// against the current request URL (Astro.url) rather than the static `site`, so
// the card loads from whatever origin actually serves the page: the prod origin
// in the prerendered build (where `site` seeds Astro.url), but the localhost /
// tunnel host during `astro dev` (e.g. sharing a *.trycloudflare.com link to
// Discord). canonical/site stay the prod origin for SEO.
const ogImageUrl = new URL(ogImage, Astro.url).href;
---

<html lang={lang} class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={twitterTitle} />
    <meta property="twitter:description" content={twitterDescription} />
    <meta property="twitter:image" content={ogImageUrl} />

    <link rel="canonical" href={canonical} />

    <!-- Site-wide analytics: tracks all routes that use this layout (or any layout that wraps it). -->
    <script
      is:inline
      defer
      data-domain="operationbifrost.com"
      src="https://plausible.io/js/script.js"></script>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
