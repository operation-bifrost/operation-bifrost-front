{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "start": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "wrangler types && astro preview",
    "astro": "astro",
    "assets:webp": "node scripts/images-to-webp.mjs",
    "assets:thumbs": "node scripts/generate-thumbs.mjs",
    "assets:woff2": "node scripts/fonts-to-woff2.mjs",
    "assets:og": "node scripts/render-og.mjs",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "node scripts/check-deploy-target.mjs && wrangler deploy",
    "wrangler:deploy:dev": "CLOUDFLARE_ENV=dev yarn build && node scripts/check-deploy-target.mjs && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,astro,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.5.4",
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.1",
    "@fontsource/krub": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.23.12",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.7",
    "recharts": "^3.0.0",
    "svelte": "^5.55.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react-is": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.18.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.8.0",
    "sharp": "^0.35.2",
    "svelte-eslint-parser": "^1.6.1",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.94.0"
  },
  "packageManager": "yarn@4.9.1"
}
